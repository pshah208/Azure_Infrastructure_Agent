# Copy to .env.local for local dev. .env.local is gitignored.
#
# No passwords live here, ever. Endpoints are non-secret; secrets (AI Search
# admin key, Fabric SP secret, ...) live in Key Vault and are read at runtime via
# DefaultAzureCredential. This mirrors the Lulu IQ pattern.
#
# With NOTHING configured, the app runs in LOCAL mode: the four IQ tools serve
# synthetic JSON from data/ and the concierge falls back to a deterministic
# reasoner. Configure the blocks below to light up the real Azure services.

# --- Identity / Key Vault ------------------------------------------------
AZURE_CLIENT_ID=
AZURE_KEY_VAULT_URI=

# --- Azure AI Foundry (Foundry IQ + the Loan Concierge agent) ------------
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o
FOUNDRY_AGENT_CONCIERGE=loan-concierge
# Set true once the identity has the agents data-plane role; otherwise the
# concierge uses the local reasoner.
FOUNDRY_USE_AGENT=false

# --- Azure AI Search (Foundry IQ knowledge base) -------------------------
AI_SEARCH_ENDPOINT=
AI_SEARCH_INDEX=mortgage-knowledge
# KV secret name that holds the AI Search admin/query key (value never in env).
AI_SEARCH_KEY_KV_SECRET=ai-search-key
# Or, for local dev only, put the key directly here:
AI_SEARCH_KEY=

# --- Fabric IQ (borrower + document data via the Fabric SQL endpoint) -----
FABRIC_SQL_ENDPOINT=
FABRIC_DATABASE=
FABRIC_BORROWER_TABLE=dbo.borrowers
FABRIC_DOCUMENTS_TABLE=dbo.borrower_documents

# --- Web IQ (market rates) ------------------------------------------------
# Optional public rates API; blank uses the synthetic snapshot.
WEB_IQ_RATES_URL=

# --- Container App self-context (populated at deploy time) ----------------
DEPLOY_REVISION=
GIT_SHA_SHORT=
AZURE_REGION=eastus2
