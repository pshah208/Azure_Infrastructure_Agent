# Orchestrator runtime configuration.
# Copy to .env and adjust. The demo works with all values left as-is (mock mode).

# mock = no Azure needed (default) | foundry = call a real Azure AI Foundry project
AI_MODE=mock

# Required only when AI_MODE=foundry
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_ID=
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o

# IQ grounding sources (foundry mode)
AI_SEARCH_ENDPOINT=
AI_SEARCH_INDEX=mortgage-knowledge
BING_CONNECTION_ID=
# Fabric IQ live data (see README "Add the dataset to Fabric later" runbook).
# Leave blank to keep Fabric IQ on canned data even in foundry mode.
FABRIC_SQL_ENDPOINT=
FABRIC_DATABASE=
FABRIC_BORROWER_TABLE=dbo.borrowers
GRAPH_SCOPES=Mail.Read Files.Read.All

# Demo pacing so each IQ is visibly "active" on stage (seconds)
IQ_STEP_DELAY_SECONDS=1.1
